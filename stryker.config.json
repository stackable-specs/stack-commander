{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing config for the typescript-bun stack. Scoped to pure-logic modules per quality/mutation-testing rule 3.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "reporters": ["html", "clear-text", "progress"],
  "mutate": ["src/commands/**/*.ts", "!src/**/*.test.ts"],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp",
  "incrementalFile": ".stryker-tmp/incremental.json"
}
